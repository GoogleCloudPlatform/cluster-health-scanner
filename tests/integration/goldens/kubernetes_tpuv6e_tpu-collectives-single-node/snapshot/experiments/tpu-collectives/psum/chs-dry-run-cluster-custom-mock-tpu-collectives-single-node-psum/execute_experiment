#!/bin/bash
if [ "tpu-collectives" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-collectives scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum/chs-dry-run-cluster-custom-mock-tpu-collectives-single-node-psum.out

