#!/bin/bash
#SBATCH --deadline=<DEADLINE>
#SBATCH --exclusive
#SBATCH --gpus-per-node 8
#SBATCH --ntasks-per-node 8
#SBATCH --time=10
#SBATCH -J chs-nccl-cluster-all-reduce
#SBATCH -N 2
#SBATCH -e <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/slurm-%j.err
#SBATCH -o <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/slurm-%j.out
#SBATCH -w node1,node2

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/slurm_experiment_sbatch
# * If this file is not the same as the above path, it is unlikely that this script
# * is used when `ramble on` executes experiments.
# ****************************************************


cd <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce

scontrol show hostnames > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/hostfile

rm -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_config" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/chs-nccl-cluster-all-reduce.out"
touch "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_config" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/chs-nccl-cluster-all-reduce.out"
if [ -d "/usr/local/gib/scripts" ]; then
    NCCL_LIB_DIR=/usr/local/gib/scripts . /usr/local/gib/scripts/set_nccl_env.sh
fi
export NCCL_DEBUG=INFO;
export NCCL_NET=gIB;
export NCCL_TESTS_SPLIT_MASK="";
export OMPI_MCA_btl=tcp,self;
export OMPI_MCA_btl_tcp_if_include="enp0s1,enp0s2";
scontrol show config > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_config
srun --mpi=pmix --export=ALL --container-workdir /third_party/nccl-tests/build/ --container-image <HOME_DIR>/.local/share/chs/images/nccl-plugin-gib-diagnostic:v1.1.0.sqsh --container-mounts "/var/tmp" --container-writable --wait=60 bash -c "export LD_LIBRARY_PATH=/usr/local/gib/lib64:${LD_LIBRARY_PATH}; ./all_reduce_perf -b 256M -e 8G -f 2 -g 1 -w 5 --iters 100 -c 1" >> "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/chs-nccl-cluster-all-reduce.out" 2>&1
date +%s > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-cluster-all-reduce/.slurm_script_end_time

