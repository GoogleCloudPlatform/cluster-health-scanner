#!/bin/bash
if [ "tpu-collectives" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-collectives scaffolding experiment."
    echo "Submitted chs-tpu-collectives-psum at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-psum/chs-tpu-collectives-psum.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-psum/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-psum/jobset.yaml"
echo "Submitted chs-tpu-collectives-psum at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-psum/chs-tpu-collectives-psum.out

