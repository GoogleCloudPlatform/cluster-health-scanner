#!/bin/bash
if [ "tpu-host-device" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-host-device scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-tpu-host-device at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-dry-run-cluster-custom-mock-tpu-host-device/chs-dry-run-cluster-custom-mock-tpu-host-device.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-dry-run-cluster-custom-mock-tpu-host-device/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-dry-run-cluster-custom-mock-tpu-host-device/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-tpu-host-device at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-dry-run-cluster-custom-mock-tpu-host-device/chs-dry-run-cluster-custom-mock-tpu-host-device.out

