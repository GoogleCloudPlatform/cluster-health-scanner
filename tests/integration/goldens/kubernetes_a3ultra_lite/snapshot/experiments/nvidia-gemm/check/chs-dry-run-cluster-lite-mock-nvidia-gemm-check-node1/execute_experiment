#!/bin/bash
if [ "nvidia-gemm" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-gemm scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1/jobset.yaml"
echo "Submitted chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1/chs-dry-run-cluster-lite-mock-nvidia-gemm-check-node1.out

