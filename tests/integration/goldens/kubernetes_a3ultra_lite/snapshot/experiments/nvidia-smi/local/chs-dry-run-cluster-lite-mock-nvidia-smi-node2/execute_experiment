#!/bin/bash
if [ "nvidia-smi" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-smi scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-lite-mock-nvidia-smi-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-lite-mock-nvidia-smi-node2/chs-dry-run-cluster-lite-mock-nvidia-smi-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-lite-mock-nvidia-smi-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-lite-mock-nvidia-smi-node2/jobset.yaml"
echo "Submitted chs-dry-run-cluster-lite-mock-nvidia-smi-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-lite-mock-nvidia-smi-node2/chs-dry-run-cluster-lite-mock-nvidia-smi-node2.out

