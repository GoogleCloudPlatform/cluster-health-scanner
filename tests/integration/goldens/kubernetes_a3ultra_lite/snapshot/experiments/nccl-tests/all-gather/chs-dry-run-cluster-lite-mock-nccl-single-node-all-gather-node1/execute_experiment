#!/bin/bash
if [ "nccl-tests" = "chs" ]; then
    echo "Skipping JobSet submission for nccl-tests scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1/jobset.yaml"
echo "Submitted chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1/chs-dry-run-cluster-lite-mock-nccl-single-node-all-gather-node1.out

