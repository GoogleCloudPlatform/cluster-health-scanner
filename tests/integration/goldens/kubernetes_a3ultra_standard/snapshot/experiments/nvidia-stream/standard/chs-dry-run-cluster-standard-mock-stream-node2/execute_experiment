#!/bin/bash
if [ "nvidia-stream" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-stream scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-standard-mock-stream-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-stream/standard/chs-dry-run-cluster-standard-mock-stream-node2/chs-dry-run-cluster-standard-mock-stream-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-stream/standard/chs-dry-run-cluster-standard-mock-stream-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-stream/standard/chs-dry-run-cluster-standard-mock-stream-node2/jobset.yaml"
echo "Submitted chs-dry-run-cluster-standard-mock-stream-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-stream/standard/chs-dry-run-cluster-standard-mock-stream-node2/chs-dry-run-cluster-standard-mock-stream-node2.out

