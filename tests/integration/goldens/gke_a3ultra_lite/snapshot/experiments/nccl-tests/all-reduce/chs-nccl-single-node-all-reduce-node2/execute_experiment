#!/bin/bash
if [ "nccl-tests" = "chs" ]; then
    echo "Skipping JobSet submission for nccl-tests scaffolding experiment."
    echo "Submitted chs-nccl-single-node-all-reduce-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-single-node-all-reduce-node2/chs-nccl-single-node-all-reduce-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-single-node-all-reduce-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-single-node-all-reduce-node2/jobset.yaml"
echo "Submitted chs-nccl-single-node-all-reduce-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/chs-nccl-single-node-all-reduce-node2/chs-nccl-single-node-all-reduce-node2.out

