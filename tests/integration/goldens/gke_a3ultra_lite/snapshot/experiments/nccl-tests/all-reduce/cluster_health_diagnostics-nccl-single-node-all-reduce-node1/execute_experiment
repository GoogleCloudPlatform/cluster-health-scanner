#!/bin/bash
if [ "nccl-tests" = "chs" ]; then
    echo "Skipping JobSet submission for nccl-tests scaffolding experiment."
    echo "Submitted cluster_health_diagnostics-nccl-single-node-all-reduce-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-single-node-all-reduce-node1/cluster_health_diagnostics-nccl-single-node-all-reduce-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-single-node-all-reduce-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-single-node-all-reduce-node1/jobset.yaml"
echo "Submitted cluster_health_diagnostics-nccl-single-node-all-reduce-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-single-node-all-reduce-node1/cluster_health_diagnostics-nccl-single-node-all-reduce-node1.out

