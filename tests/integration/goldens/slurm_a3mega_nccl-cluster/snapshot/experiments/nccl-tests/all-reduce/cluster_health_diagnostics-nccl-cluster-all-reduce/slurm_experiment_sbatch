#!/bin/bash
#SBATCH --deadline=<DEADLINE>
#SBATCH --exclusive
#SBATCH --gpus-per-node 8
#SBATCH --ntasks-per-node 8
#SBATCH --time=10
#SBATCH -J nccl-tests_all-reduce_cluster_health_diagnostics-nccl-cluster-all-reduce
#SBATCH -N 2
#SBATCH -e <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/slurm-%j.err
#SBATCH -o <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/slurm-%j.out
#SBATCH -w node1,node2

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/slurm_experiment_sbatch
# * If this file is not the same as the above path, it is unlikely that this script
# * is used when `ramble on` executes experiments.
# ****************************************************


cd <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce

scontrol show hostnames > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/hostfile

rm -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_config" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce.out"
touch "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_config" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce.out"
if [ -d "/usr/local/nvidia/lib64" ]; then
    NCCL_LIB_DIR=/usr/local/nvidia/lib64 . /usr/local/nvidia/lib64/nccl-env-profile.sh
fi
if [ -d "/var/lib/tcpxo/lib64" ]; then
    NCCL_LIB_DIR=/var/lib/tcpxo/lib64 . /var/lib/tcpxo/lib64/nccl-env-profile.sh
fi
export NCCL_DEBUG=INFO;
export NCCL_FASTRAK_CTRL_DEV=enp0s12;
export NCCL_FASTRAK_IFNAME=enp6s0,enp7s0,enp13s0,enp14s0,enp134s0,enp135s0,enp141s0,enp142s0;
export NCCL_FASTRAK_LLCM_DEVICE_DIRECTORY=/dev/aperture_devices;
export NCCL_SOCKET_IFNAME=enp0s12;
export NCCL_TESTS_SPLIT_MASK="";
scontrol show config > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_config
LOCK_DIR="<WORKSPACE_ROOT>/shared/nccl-tests-master.lock"
SUCCESS_FILE="<WORKSPACE_ROOT>/shared/nccl-tests-master/.success"
FAIL_FILE="<WORKSPACE_ROOT>/shared/nccl-tests-master.failed"

if mkdir "$LOCK_DIR" 2>/dev/null; then
  echo "Acquired build lock. Starting compilation..."
  if [ ! -f "$SUCCESS_FILE" ]; then
    srun -N 1 --ntasks=1 --container-mounts="<WORKSPACE_ROOT>/shared:<WORKSPACE_ROOT>/shared" --container-image="<HOME_DIR>/.local/share/chs/images/pytorch:24.09-py3.sqsh" bash -c "[ ! -d <WORKSPACE_ROOT>/shared/nccl-tests-master ] && git clone https://github.com/NVIDIA/nccl-tests.git <WORKSPACE_ROOT>/shared/nccl-tests-master; cd <WORKSPACE_ROOT>/shared/nccl-tests-master && git checkout master && make MPI=1 CC=mpicc CXX=mpicxx -j"
    BUILD_STATUS=$?
    if [ $BUILD_STATUS -eq 0 ]; then
      echo "Compilation successful."
      touch "$SUCCESS_FILE"
    else
      echo "Compilation failed with exit code $BUILD_STATUS!"
      touch "$FAIL_FILE"
      rmdir "$LOCK_DIR"
      exit $BUILD_STATUS
    fi
  fi
  rmdir "$LOCK_DIR"
else
  echo "Waiting for another node to finish compiling..."
  wait_time=0
  max_wait=1800
  while [ ! -f "$SUCCESS_FILE" ]; do
    if [ -f "$FAIL_FILE" ]; then
      echo "Another node failed to compile NCCL tests. Aborting."
      exit 1
    fi
    if [ $wait_time -ge $max_wait ]; then
      echo "Timeout waiting for compile lock. Aborting."
      exit 1
    fi
    sleep 5
    wait_time=$((wait_time + 5))
  done
  echo "Compilation finished by another node. Proceeding."
fi >> "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce.out" 2>&1
srun --mpi=pmi2 --export=ALL --container-workdir <WORKSPACE_ROOT>/shared/nccl-tests-master/build/ --container-image <HOME_DIR>/.local/share/chs/images/pytorch:24.09-py3.sqsh --container-mounts "/var/tmp:/var/tmp,<WORKSPACE_ROOT>/shared/nccl-tests-master:<WORKSPACE_ROOT>/shared/nccl-tests-master,/var/lib/tcpxo/lib64/" --container-writable --wait=60 bash -c "export LD_LIBRARY_PATH=/var/lib/tcpxo/lib64:/usr/lib/x86_64-linux-gnu:\$LD_LIBRARY_PATH; ./all_reduce_perf -b 256M -e 8G -f 2 -g 1 -w 5 --iters 100 -c 1" >> "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce.out" 2>&1
date +%s > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_script_end_time

