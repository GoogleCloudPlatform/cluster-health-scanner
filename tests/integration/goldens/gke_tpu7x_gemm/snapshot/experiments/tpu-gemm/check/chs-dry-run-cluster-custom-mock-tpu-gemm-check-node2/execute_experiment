#!/bin/bash
if [ "tpu-gemm" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-gemm scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2/chs-dry-run-cluster-custom-mock-tpu-gemm-check-node2.out

