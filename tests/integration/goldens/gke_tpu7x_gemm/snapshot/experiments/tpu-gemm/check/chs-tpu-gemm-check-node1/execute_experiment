#!/bin/bash
if [ "tpu-gemm" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-gemm scaffolding experiment."
    echo "Submitted chs-tpu-gemm-check-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node1/chs-tpu-gemm-check-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node1/jobset.yaml"
echo "Submitted chs-tpu-gemm-check-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node1/chs-tpu-gemm-check-node1.out

