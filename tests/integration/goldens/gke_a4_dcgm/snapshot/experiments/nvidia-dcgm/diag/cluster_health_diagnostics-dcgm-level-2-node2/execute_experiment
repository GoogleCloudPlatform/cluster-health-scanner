#!/bin/bash
if [ "nvidia-dcgm" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-dcgm scaffolding experiment."
    echo "Submitted cluster_health_diagnostics-dcgm-level-2-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-2-node2/cluster_health_diagnostics-dcgm-level-2-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-2-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-2-node2/jobset.yaml"
echo "Submitted cluster_health_diagnostics-dcgm-level-2-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-2-node2/cluster_health_diagnostics-dcgm-level-2-node2.out

