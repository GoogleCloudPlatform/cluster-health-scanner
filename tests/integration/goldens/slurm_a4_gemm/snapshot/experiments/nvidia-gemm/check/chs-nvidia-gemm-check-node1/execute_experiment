cd "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1"

rm -f "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_config" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out"
