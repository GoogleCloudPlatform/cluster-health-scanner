scontrol show config > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_config
export ENROOT_RUNTIME_PATH="$HOME/.enroot/run";
export XDG_RUNTIME_DIR="$HOME/.enroot";
srun --cpu-bind=none --mpi=pmix --container-workdir /workspace/microbenchmarks --container-image <HOME_DIR>/.local/share/chs/images/hpc-benchmarks:25.09.sqsh --container-writable --container-mounts <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1:<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1 --wait=60 ./gemm_tests.sh --gpu-affinity 0:1:2:3:4:5:6:7 --cpu-affinity 0-55:0-55:0-55:0-55:56-111:56-111:56-111:56-111 --mem-affinity 0:0:0:0:1:1:1:1 --params "--mode=check --type=fp64emu --m=32768 --n=32768 --k=32768 --iter=32" | tee <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1_local.out >> "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out" 2>&1
srun --cpu-bind=none --mpi=pmix --container-workdir /workspace/microbenchmarks --container-image <HOME_DIR>/.local/share/chs/images/hpc-benchmarks:25.09.sqsh --container-writable --container-mounts <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1:<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1 --wait=60 sh -c 'RANK="${SLURM_PROCID:-${OMPI_COMM_WORLD_RANK:-0}}"; if [ "$RANK" -eq 0 ]; then ./gemm_parse_results.sh --correctness --list --stats <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1_local.out; fi' >> "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out" 2>&1
