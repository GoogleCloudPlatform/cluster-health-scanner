#!/bin/bash
if [ "tpu-collectives" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-collectives scaffolding experiment."
    echo "Submitted chs-tpu-collectives-all_gather-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/all_gather/chs-tpu-collectives-all_gather-node1/chs-tpu-collectives-all_gather-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/all_gather/chs-tpu-collectives-all_gather-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/all_gather/chs-tpu-collectives-all_gather-node1/jobset.yaml"
echo "Submitted chs-tpu-collectives-all_gather-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/all_gather/chs-tpu-collectives-all_gather-node1/chs-tpu-collectives-all_gather-node1.out

