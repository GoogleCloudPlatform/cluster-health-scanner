#!/bin/bash
# This is a template execution script for
# running the execute pipeline.
#
# Variables surrounded by curly braces will be expanded
# when generating a specific execution script.
# Some example variables are:
#   - experiment_run_dir (Will be replaced with the experiment directory)
#   - command (Will be replaced with the command to run the experiment)
#   - log_dir (Will be replaced with the logs directory)
#   - experiment_name (Will be replaced with the name of the experiment)
#   - workload_run_dir (Will be replaced with the directory of the workload
#   - application_name (Will be replaced with the name of the application)
#   - n_nodes (Will be replaced with the required number of nodes)
#   Any experiment parameters will be available as variables as well.

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/slurm_experiment_sbatch
# * If this file is not the same as the above path, it is unlikely that this script
# * is used when `ramble on` executes experiments.
# ****************************************************


cd "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2"

rm -f "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_config" "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs-tpu-gemm-check-node2.out"
touch "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_config" "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs-tpu-gemm-check-node2.out"
export ENROOT_RUNTIME_PATH="$HOME/.enroot/run";
export XDG_RUNTIME_DIR="$HOME/.enroot";
scontrol show config > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_config
printf '%b' 'benchmarks:\n- benchmark_name: gemm_multiple_run\n  trace_dir: "../microbenchmarks/gemm_multiple_run_bf16"\n  csv_path: "../microbenchmarks/gemm_multiple_run_bf16"\n  xlml_metrics_dir: "../microbenchmarks/gemm_multiple_run_bf16"\n  xla_dump_dir: "../microbenchmarks/gemm_multiple_run_bf16/hlo_graphs"\n  benchmark_sweep_params:\n  - {m: 16384, k: 16384, n: 16384, num_runs: 100, dtype: '\''bfloat16'\''}\n' | tee <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs_tpu_gemm.yaml >> "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs-tpu-gemm-check-node2.out" 2>&1
export TPU_HOST_BOUNDS=1,1,1 && export HOST_BOUNDS=1,1,1 && export TPU_TOPOLOGY=2x2x1 && export TPU_ACCELERATOR_TYPE=v6e-4 && srun --cpu-bind=none --container-workdir /app/accelerator-microbenchmarks --container-image <HOME_DIR>/.local/share/chs/images/accelerator-microbenchmarks:latest.sqsh --container-writable --container-mounts /dev/vfio:/dev/vfio,<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2:<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2 --wait=60 python3 -u /app/accelerator-microbenchmarks/Ironwood/src/run_benchmark.py --config <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs_tpu_gemm.yaml 2>&1 >> "<WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/chs-tpu-gemm-check-node2.out" 2>&1
date +%s > <WORKSPACE_ROOT>/experiments/tpu-gemm/check/chs-tpu-gemm-check-node2/.slurm_script_end_time
