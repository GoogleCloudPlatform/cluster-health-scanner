#!/bin/bash
# This is a template execution script for
# running the execute pipeline.
#
# Variables surrounded by curly braces will be expanded
# when generating a specific execution script.
# Some example variables are:
#   - experiment_run_dir (Will be replaced with the experiment directory)
#   - command (Will be replaced with the command to run the experiment)
#   - log_dir (Will be replaced with the logs directory)
#   - experiment_name (Will be replaced with the name of the experiment)
#   - workload_run_dir (Will be replaced with the directory of the workload
#   - application_name (Will be replaced with the name of the application)
#   - n_nodes (Will be replaced with the required number of nodes)
#   Any experiment parameters will be available as variables as well.

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/slurm_experiment_sbatch
# * If this file is not the same as the above path, it is unlikely that this script
# * is used when `ramble on` executes experiments.
# ****************************************************


cd "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1"

rm -f "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_config" "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/chs-nvidia-smi-node1.out"
touch "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_config" "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/chs-nvidia-smi-node1.out"
scontrol show config > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_config
nvidia-smi --query-gpu=index,name,driver_version,pstate,pci.bus_id,serial,uuid,power.draw,power.limit,clocks.gr,clocks.mem --format=csv,noheader,nounits >> "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/chs-nvidia-smi-node1.out" 2>&1
echo "GPU Count: $(nvidia-smi --query-gpu=index --format=csv,noheader | wc -l)" >> "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/chs-nvidia-smi-node1.out" 2>&1
nvidia-smi | grep -o "CUDA Version: [0-9.]*" || true >> "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/chs-nvidia-smi-node1.out" 2>&1
date +%s > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-nvidia-smi-node1/.slurm_script_end_time
