export OMPI_MCA_btl_tcp_if_include="enp0s1,enp0s2";
if [ -d "/usr/local/gib/scripts" ]; then
    NCCL_LIB_DIR=/usr/local/gib/scripts . /usr/local/gib/scripts/set_nccl_env.sh
fi
scontrol show config > <WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/.slurm_config
srun --mpi=pmix --export=ALL --container-workdir /third_party/nccl-tests/build/ --container-image <HOME_DIR>/.local/share/chs/images/nccl-plugin-gib-diagnostic:v1.1.0.sqsh --container-mounts "/var/tmp" --container-writable --wait=60 bash -c "export LD_LIBRARY_PATH=/usr/local/gib/lib64:${LD_LIBRARY_PATH}; ./all_reduce_perf -b 256M -e 8G -f 2 -g 1 -w 5 --iters 100 -c 1" >> "<WORKSPACE_ROOT>/experiments/nccl-tests/all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce/cluster_health_diagnostics-nccl-cluster-all-reduce.out" 2>&1
