#!/bin/bash
if [ "nccl-tests" = "chs" ]; then
    echo "Skipping JobSet submission for nccl-tests scaffolding experiment."
    echo "Submitted cluster_health_diagnostics-nccl-cluster-all-to-all at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all/jobset.yaml"
echo "Submitted cluster_health_diagnostics-nccl-cluster-all-to-all at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all/cluster_health_diagnostics-nccl-cluster-all-to-all.out

