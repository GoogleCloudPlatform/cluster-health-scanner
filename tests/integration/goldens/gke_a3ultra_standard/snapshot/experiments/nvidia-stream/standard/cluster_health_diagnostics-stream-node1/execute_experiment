#!/bin/bash
if [ "nvidia-stream" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-stream scaffolding experiment."
    echo "Submitted cluster_health_diagnostics-stream-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-stream/standard/cluster_health_diagnostics-stream-node1/cluster_health_diagnostics-stream-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-stream/standard/cluster_health_diagnostics-stream-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-stream/standard/cluster_health_diagnostics-stream-node1/jobset.yaml"
echo "Submitted cluster_health_diagnostics-stream-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-stream/standard/cluster_health_diagnostics-stream-node1/cluster_health_diagnostics-stream-node1.out

