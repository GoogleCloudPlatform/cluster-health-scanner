#!/bin/bash
if [ "tpu-host-device" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-host-device scaffolding experiment."
    echo "Submitted chs-tpu-host-device-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-tpu-host-device-node2/chs-tpu-host-device-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-tpu-host-device-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-tpu-host-device-node2/jobset.yaml"
echo "Submitted chs-tpu-host-device-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-host-device/check/chs-tpu-host-device-node2/chs-tpu-host-device-node2.out

