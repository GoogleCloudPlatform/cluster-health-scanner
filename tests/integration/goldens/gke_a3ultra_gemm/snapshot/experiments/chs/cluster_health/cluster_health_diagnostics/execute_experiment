#!/bin/bash
if [ "chs" = "chs" ]; then
    echo "Skipping JobSet submission for chs scaffolding experiment."
    echo "Submitted cluster_health_diagnostics at $(date)" > <WORKSPACE_ROOT>/experiments/chs/cluster_health/cluster_health_diagnostics/cluster_health_diagnostics.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/chs/cluster_health/cluster_health_diagnostics/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/chs/cluster_health/cluster_health_diagnostics/jobset.yaml"
echo "Submitted cluster_health_diagnostics at $(date)" > <WORKSPACE_ROOT>/experiments/chs/cluster_health/cluster_health_diagnostics/cluster_health_diagnostics.out

