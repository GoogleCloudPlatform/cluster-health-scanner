#!/bin/bash
if [ "nccl-tests" = "chs" ]; then
    echo "Skipping JobSet submission for nccl-tests scaffolding experiment."
    echo "Submitted chs-nccl-cluster-all-gather at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-nccl-cluster-all-gather/chs-nccl-cluster-all-gather.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-nccl-cluster-all-gather/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-nccl-cluster-all-gather/jobset.yaml"
echo "Submitted chs-nccl-cluster-all-gather at $(date)" > <WORKSPACE_ROOT>/experiments/nccl-tests/all-gather/chs-nccl-cluster-all-gather/chs-nccl-cluster-all-gather.out

