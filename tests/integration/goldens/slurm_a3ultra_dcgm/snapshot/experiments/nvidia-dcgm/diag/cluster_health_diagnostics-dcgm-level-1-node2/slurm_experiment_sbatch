#!/bin/bash
#SBATCH --deadline=<DEADLINE>
#SBATCH --exclusive
#SBATCH --gpus-per-node 8
#SBATCH --ntasks-per-node 8
#SBATCH --time=10
#SBATCH -J nvidia-dcgm_diag_cluster_health_diagnostics-dcgm-level-1-node2
#SBATCH -N 1
#SBATCH -e <WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-1-node2/slurm-%j.err
#SBATCH -o <WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-1-node2/slurm-%j.out
#SBATCH -w node2

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/nvidia-dcgm/diag/cluster_health_diagnostics-dcgm-level-1-node2/slurm_experiment_sbatch
