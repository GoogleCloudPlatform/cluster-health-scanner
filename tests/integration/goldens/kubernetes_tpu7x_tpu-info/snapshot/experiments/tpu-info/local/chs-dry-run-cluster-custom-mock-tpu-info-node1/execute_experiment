#!/bin/bash
if [ "tpu-info" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-info scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-tpu-info-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-info/local/chs-dry-run-cluster-custom-mock-tpu-info-node1/chs-dry-run-cluster-custom-mock-tpu-info-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-info/local/chs-dry-run-cluster-custom-mock-tpu-info-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-info/local/chs-dry-run-cluster-custom-mock-tpu-info-node1/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-tpu-info-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-info/local/chs-dry-run-cluster-custom-mock-tpu-info-node1/chs-dry-run-cluster-custom-mock-tpu-info-node1.out

