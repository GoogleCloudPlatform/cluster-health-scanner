#!/bin/bash
#SBATCH --deadline=<DEADLINE>
#SBATCH --exclusive
#SBATCH --gpus-per-node 8
#SBATCH --ntasks-per-node 8
#SBATCH --time=10
#SBATCH -J chs-nvidia-gemm-check
#SBATCH -N 1
#SBATCH -e <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/slurm-%j.err
#SBATCH -o <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/slurm-%j.out
#SBATCH -w node1

# ****************************************************
# * Workflow manager: slurm
# * Execution script is: <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/slurm_experiment_sbatch
# * If this file is not the same as the above path, it is unlikely that this script
# * is used when `ramble on` executes experiments.
# ****************************************************


cd <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1

scontrol show hostnames > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/hostfile

rm -f "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_config" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out"
touch "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_config" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_job_info" "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out"
scontrol show config > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_config
export XDG_RUNTIME_DIR="$HOME/.enroot";
srun --cpu-bind=none --mpi=pmix --container-workdir /workspace/microbenchmarks --container-image <HOME_DIR>/.local/share/chs/images/hpc-benchmarks:25.09.sqsh --container-writable --container-mounts <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1:<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1 --wait=60 ./gemm_tests.sh --gpu-affinity 0:1:2:3:4:5:6:7 --cpu-affinity 0-51:0-51:0-51:0-51:52-103:52-103:52-103:52-103 --mem-affinity 0:0:0:0:1:1:1:1 --params "--mode=check --type=fp64 --m=16384 --n=16384 --k=16384 --iter=32" | tee <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1_local.out >> "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out" 2>&1
srun --cpu-bind=none --mpi=pmix --container-workdir /workspace/microbenchmarks --container-image <HOME_DIR>/.local/share/chs/images/hpc-benchmarks:25.09.sqsh --container-writable --container-mounts <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1:<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1 --wait=60 sh -c 'RANK="${SLURM_PROCID:-${OMPI_COMM_WORLD_RANK:-0}}"; if [ "$RANK" -eq 0 ]; then ./gemm_parse_results.sh --correctness --list --stats <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1_local.out; fi' >> "<WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/chs-nvidia-gemm-check-node1.out" 2>&1
date +%s > <WORKSPACE_ROOT>/experiments/nvidia-gemm/check/chs-nvidia-gemm-check-node1/.slurm_script_end_time

