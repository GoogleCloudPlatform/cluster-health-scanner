#!/bin/bash
if [ "tpu-hbm" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-hbm scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-tpu-hbm-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-hbm/check/chs-dry-run-cluster-custom-mock-tpu-hbm-node1/chs-dry-run-cluster-custom-mock-tpu-hbm-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-hbm/check/chs-dry-run-cluster-custom-mock-tpu-hbm-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-hbm/check/chs-dry-run-cluster-custom-mock-tpu-hbm-node1/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-tpu-hbm-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-hbm/check/chs-dry-run-cluster-custom-mock-tpu-hbm-node1/chs-dry-run-cluster-custom-mock-tpu-hbm-node1.out

