#!/bin/bash
if [ "tpu-collectives" = "chs" ]; then
    echo "Skipping JobSet submission for tpu-collectives scaffolding experiment."
    echo "Submitted chs-tpu-collectives-single-node-psum-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-single-node-psum-node2/chs-tpu-collectives-single-node-psum-node2.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-single-node-psum-node2/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-single-node-psum-node2/jobset.yaml"
echo "Submitted chs-tpu-collectives-single-node-psum-node2 at $(date)" > <WORKSPACE_ROOT>/experiments/tpu-collectives/psum/chs-tpu-collectives-single-node-psum-node2/chs-tpu-collectives-single-node-psum-node2.out

