#!/bin/bash
if [ "nvidia-smi" = "chs" ]; then
    echo "Skipping JobSet submission for nvidia-smi scaffolding experiment."
    echo "Submitted chs-dry-run-cluster-custom-mock-nvidia-smi-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-custom-mock-nvidia-smi-node1/chs-dry-run-cluster-custom-mock-nvidia-smi-node1.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-custom-mock-nvidia-smi-node1/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-custom-mock-nvidia-smi-node1/jobset.yaml"
echo "Submitted chs-dry-run-cluster-custom-mock-nvidia-smi-node1 at $(date)" > <WORKSPACE_ROOT>/experiments/nvidia-smi/local/chs-dry-run-cluster-custom-mock-nvidia-smi-node1/chs-dry-run-cluster-custom-mock-nvidia-smi-node1.out

