#!/bin/bash
if [ "chs" = "chs" ]; then
    echo "Skipping JobSet submission for chs scaffolding experiment."
    echo "Submitted chs at $(date)" > <WORKSPACE_ROOT>/experiments/chs/cluster_health/chs/chs.out
    exit 0
fi

kubectl delete -f "<WORKSPACE_ROOT>/experiments/chs/cluster_health/chs/jobset.yaml" --ignore-not-found || true
kubectl apply -f "<WORKSPACE_ROOT>/experiments/chs/cluster_health/chs/jobset.yaml"
echo "Submitted chs at $(date)" > <WORKSPACE_ROOT>/experiments/chs/cluster_health/chs/chs.out

